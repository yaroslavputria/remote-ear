<?xml version="1.0" encoding="utf-8"?>
<!--
  The notification glyph: one ring and a filled centre.

  The launcher icon's outer ring is deliberately absent. At 24 dp three concentric shapes turn into
  a grey smudge, so the design drops the outer ring at the smallest size and keeps the two inner
  ones - which are what make the mark recognisable. Single colour, because the system tints it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M12,2 a10,10 0 1,0 0,20 a10,10 0 1,0 0,-20"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,7 a5,5 0 1,0 0,10 a5,5 0 1,0 0,-10" />
</vector>
